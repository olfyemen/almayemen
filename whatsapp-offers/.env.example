# انسخ هذا الملف إلى .env واملأ القيم من لوحة Meta for Developers

# توكن الوصول (Access Token) من WhatsApp > API Setup
WHATSAPP_TOKEN=

# معرّف رقم الهاتف (Phone Number ID) من نفس الصفحة
PHONE_NUMBER_ID=

# كلمة سر تختارينها أنتِ للتحقق من الـWebhook (أي نص سري)
VERIFY_TOKEN=my-verify-token-123

# المنفذ الذي يعمل عليه الخادم
PORT=3000

# لغة القوالب المعتمدة في Meta (مثال: ar للعربية)
TEMPLATE_LANG=ar
